<Window x:Class="MusicSubtitle.Views.PointSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MusicSubtitle.Converters"
        Title="点同步" Height="330" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeFmt"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择两条锚点字幕，为每条填写「应当出现的时间」。" Margin="0,0,0,8"
                   Foreground="#D0D6E0" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="做法：播放到目标位置，点「取当前时间」；或用 mm:ss.mmm 格式手填。" Margin="0,0,0,12"
                   Foreground="#8A93A3" TextWrapping="Wrap"/>

        <!-- 锚点 A -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="锚点 1" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <ComboBox x:Name="AnchorACombo" Grid.Column="1" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run FontSize="10" Foreground="#7A8495"
                                 Text="{Binding Start, Converter={StaticResource TimeFmt}}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Text}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="TargetAText" Grid.Column="2" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center"/>
            <Button Grid.Column="3" Content="取当前时间" Click="TakeNowA" Padding="8,3"/>
        </Grid>

        <!-- 锚点 B -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="锚点 2" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
            <ComboBox x:Name="AnchorBCombo" Grid.Column="1" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run FontSize="10" Foreground="#7A8495"
                                 Text="{Binding Start, Converter={StaticResource TimeFmt}}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Text}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="TargetBText" Grid.Column="2" Margin="0,0,8,0" Height="26" VerticalContentAlignment="Center"/>
            <Button Grid.Column="3" Content="取当前时间" Click="TakeNowB" Padding="8,3"/>
        </Grid>

        <TextBlock x:Name="HintText" Grid.Row="4" Foreground="#8A93A3" TextWrapping="Wrap" VerticalAlignment="Top"
                   Text="提示：全场按线性映射调整（含区间外），适合整体不同步或变速的情况。"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="80" Margin="0,0,8,0" Padding="0,4" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Padding="0,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
