<Window x:Class="MusicSubtitle.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:MusicSubtitle.Controls"
        xmlns:conv="clr-namespace:MusicSubtitle.Converters"
        xmlns:vm="clr-namespace:MusicSubtitle.ViewModels"
        Title="MusicSubtitle — 字幕校对" Height="720" Width="1280" MinHeight="560" MinWidth="960"
        Background="#14161C" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeFmt"/>
        <conv:TimeSpanToSecondsConverter x:Key="TimeSpanToSeconds"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#232733"/>
            <Setter Property="Foreground" Value="#E8EBF0"/>
            <Setter Property="BorderBrush" Value="#3A4050"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D3340"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1E26"/>
            <Setter Property="Foreground" Value="#E8EBF0"/>
            <Setter Property="BorderBrush" Value="#3A4050"/>
            <Setter Property="CaretBrush" Value="#E8EBF0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1B1E26"/>
            <Setter Property="Foreground" Value="#E8EBF0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#1B1E26" BorderBrush="#2E3340" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="MediaStatus" Foreground="#9AA3B2"
                           Text="{Binding MediaTitle, StringFormat=媒体: {0}}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="#9AA3B2" Text="{Binding SubtitleTitle, StringFormat=字幕: {0}}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Foreground="#6B9BFF" Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Background="#1B1E26" BorderBrush="#2E3340" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="打开媒体" Command="{Binding OpenMediaCommand}" Margin="0,0,6,0"/>
                <Button Content="打开字幕" Command="{Binding OpenSubtitleCommand}" Margin="0,0,6,0"/>
                <Button Content="保存 (Ctrl+S)" Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
                <Separator Width="1" Background="#3A4050" Margin="0,2,12,2"/>

                <Button Content="⏵ 播放/暂停" Command="{Binding PlayPauseCommand}" Margin="0,0,6,0"/>
                <Button Content="⏹ 停止" Command="{Binding StopCommand}" Margin="0,0,12,0"/>
                <Separator Width="1" Background="#3A4050" Margin="0,2,12,2"/>

                <Button Content="整体 −0.5s" Command="{Binding ShiftAllBackCommand}" Margin="0,0,4,0"/>
                <Button Content="整体 +0.5s" Command="{Binding ShiftAllForwardCommand}" Margin="0,0,12,0"/>
                <Button Content="点同步…" Command="{Binding PointSyncCommand}" Margin="0,0,12,0"/>
                <Separator Width="1" Background="#3A4050" Margin="0,2,12,2"/>

                <TextBlock Text="速率" Foreground="#9AA3B2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="72" Height="26" SelectedValue="{Binding Rate}"
                          SelectedValuePath="Content" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="0.5"/>
                    <ComboBoxItem Content="0.75"/>
                    <ComboBoxItem Content="1.0"/>
                    <ComboBoxItem Content="1.25"/>
                    <ComboBoxItem Content="1.5"/>
                    <ComboBoxItem Content="2.0"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- 主区：左 播放+时间轴，右 字幕列表 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 左列 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="190"/>
                </Grid.RowDefinitions>

                <!-- 视频/歌词预览 -->
                <Grid Grid.Row="0" Background="#0A0B0E">
                    <vlc:VideoView x:Name="VideoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Border x:Name="LyricHost" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Background="#B3000000" CornerRadius="6" Padding="18,8" Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <TextBlock x:Name="LyricText" Foreground="#F2F4F8" FontSize="26" TextWrapping="Wrap"
                                   MaxWidth="720" TextAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 进度条 + 时间 -->
                <Grid Grid.Row="1" Margin="10,6,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="#9AA3B2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="{Binding PlaybackPosition, Converter={StaticResource TimeFmt}, Mode=OneWay}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Duration, Converter={StaticResource TimeFmt}, Mode=OneWay}"/>
                    </TextBlock>
                    <Slider x:Name="ProgressSlider" Grid.Column="1" VerticalAlignment="Center" Height="20"
                            Minimum="0" Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSeconds}, Mode=OneWay}"
                            Value="{Binding PlaybackPosition, Converter={StaticResource TimeSpanToSeconds}, Mode=OneWay}"
                            PreviewMouseLeftButtonDown="Progress_PreviewMouseDown" PreviewMouseLeftButtonUp="Progress_PreviewMouseUp"
                            ValueChanged="Progress_ValueChanged"/>
                    <TextBlock Grid.Column="2" Foreground="#9AA3B2" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{Binding Rate, StringFormat={}{0:0.00}x}"/>
                </Grid>

                <!-- 时间轴 -->
                <Border Grid.Row="2" Background="#14161C">
                    <local:WaveformTimeline x:Name="Timeline"
                                            Cues="{Binding Document.Cues}"
                                            Waveform="{Binding Waveform}"
                                            MediaDuration="{Binding Duration}"
                                            PlaybackPosition="{Binding PlaybackPosition}"
                                            SelectedCue="{Binding SelectedCue, Mode=TwoWay}"
                                            CurrentCue="{Binding CurrentCue}"/>
                </Border>
            </Grid>

            <!-- 右列：字幕列表 -->
            <Grid Grid.Column="1" Background="#101216">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="字幕" Foreground="#9AA3B2" Margin="10,8,10,6" FontWeight="Bold"/>
                <ListBox x:Name="CueList" Grid.Row="1" Margin="6,0,6,6"
                         Background="#161922" BorderBrush="#2E3340" Foreground="#E8EBF0"
                         ItemsSource="{Binding Document.Cues}"
                         SelectedItem="{Binding SelectedCue, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="CueList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="10" Foreground="#7A8495"
                                           VerticalAlignment="Top" Margin="0,1,8,0">
                                    <Run Text="{Binding Start, Converter={StaticResource TimeFmt}}"/>
                                    <Run Text="→"/>
                                    <Run Text="{Binding End, Converter={StaticResource TimeFmt}}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                                           Text="{Binding Text}" Foreground="#E8EBF0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox x:Name="CueTextEditor" Grid.Row="2" Margin="8,0,8,8" Height="72" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Text="{Binding SelectedCue.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="选中字幕的文本，可直接编辑"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
